# License server. Copy to .env and fill in. Do not commit secrets.

# Supabase Auth holds accounts. license_orders holds paid keys.
# Run licensing/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the browser session cookie. Use a long random string.
ANNOTATED_SESSION_SECRET=

# Optional. Supabase Auth sends confirmation mail when email confirmations are on.
# This fallback is only used by the local memory store.
RESEND_API_KEY=
ANNOTATED_MAIL_FROM=

# Dodo Payments. Live is the default. Set DODO_PAYMENTS_ENV=test for test mode.
# Create the API key and product in the Dodo dashboard. Do not commit them.
# Webhook URL: https://annotated.click/dodo/webhook (payment.succeeded)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENV=live

ANNOTATED_PRICE_LABEL=$35
ANNOTATED_PUBLIC_ORIGIN=https://annotated.click
ANNOTATED_INSTALLER_URL=

# Desktop Google Calendar. Bun loads this file for `bun run desktop` and `bun run desktop:pack`.
# The client id is public. Never commit the client secret.
# See docs/CALENDAR.md. The same names are the GitHub Actions secrets to set
# when a release workflow is added. This repo does not have one yet.
CRUNCHCALL_GOOGLE_CLIENT_ID=333278308187-f51jcakj57d2q3c2bi1v4u3bt2ku03lo.apps.googleusercontent.com
CRUNCHCALL_GOOGLE_CLIENT_SECRET=
CRUNCHCALL_MICROSOFT_CLIENT_ID=
