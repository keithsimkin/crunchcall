{
  "name": "annotated",
  "private": true,
  "version": "0.1.0",
  "description": "annotated — local-first AI notepad for meetings.",
  "homepage": "https://annotated.click",
  "repository": {
    "type": "git",
    "url": "https://github.com/keithsimkin/crunchcall"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "bun scripts/desktop.mjs",
    "desktop:app": "electron .",
    "build": "tsc -b && vite build",
    "desktop:pack": "bun run build && bun scripts/stage-engine.mjs && bun scripts/write-oauth-config.mjs && electron-builder --win",
    "license:issue": "bun licensing/issue.mjs",
    "license:serve": "bun licensing/server.mjs",
    "appsumo:codes": "bun scripts/appsumo-generate-codes.mjs",
    "lint": "oxlint",
    "mcp": "bun mcp/server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
